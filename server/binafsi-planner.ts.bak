/** BINAFSI verified planning core: deterministic schedule calculations, not predictions. */
export type Commitment = { id:string; title:string; time:string; durationMinutes?:number; protected?:boolean; version?:number; day?:string };
export type ProposedMove = { id:string; title:string; from:string; to:string; day:string; version:number };
export type PlanOption = { name:string; note:string; moves:ProposedMove[]; conflicts:string[]; tradeoffs:string[]; valid:boolean; assumptions:string[]; impact?:{beforeConflicts:number;afterConflicts:number;minutesShifted:number;changedCommitments:number;protectedMoved:number;freeTimeMinutes:number}; };
export const minutes=(time:string)=>{const m=/^([01]\d|2[0-3]):([0-5]\d)$/.exec(time);if(!m)throw new Error('Invalid 24-hour time');return Number(m[1])*60+Number(m[2]);};
export const clock=(n:number)=>{if(!Number.isInteger(n)||n<0||n>=1440)throw new Error('Time must be on the same day');return `${String(Math.floor(n/60)).padStart(2,'0')}:${String(n%60).padStart(2,'0')}`;};
export const normalizedDay=(value?:string)=>(value?.trim().toLowerCase()||'today');
export function validateCommitment(c:Commitment){const start=minutes(c.time),duration=c.durationMinutes??60;if(!Number.isInteger(duration)||duration<15||duration>480)throw new Error(`${c.title}: duration must be 15–480 minutes`);if(start+duration>1440)throw new Error(`${c.title}: commitment crosses midnight; split it across days`);return {start,end:start+duration,day:normalizedDay(c.day)};}
export function overlapPairs(items:Commitment[]){const results:{left:Commitment;right:Commitment;overlapMinutes:number;day:string}[]=[];for(let i=0;i<items.length;i++)for(let j=i+1;j<items.length;j++){const left=items[i]!,right=items[j]!;const a=validateCommitment(left),b=validateCommitment(right);if(a.day!==b.day)continue;const overlap=Math.min(a.end,b.end)-Math.max(a.start,b.start);if(overlap>0)results.push({left,right,overlapMinutes:overlap,day:a.day});}return results;}
export function conflicts(items:Commitment[]):string[]{return overlapPairs(items).map(p=>`${p.left.title} overlaps ${p.right.title} by ${p.overlapMinutes} minutes on ${p.day}`);}
export function scheduleInsights(items:Commitment[]){const pairs=overlapPairs(items);const days=[...new Set(items.map(i=>normalizedDay(i.day)))].sort();return {total:items.length,protectedCount:items.filter(i=>i.protected).length,flexibleCount:items.filter(i=>!i.protected).length,overlapCount:pairs.length,busiestDays:days.map(day=>({day,commitments:items.filter(i=>normalizedDay(i.day)===day).length,scheduledMinutes:items.filter(i=>normalizedDay(i.day)===day).reduce((sum,i)=>sum+(i.durationMinutes??60),0)})).sort((a,b)=>b.scheduledMinutes-a.scheduledMinutes),connections:pairs.map(p=>({from:p.left.id,to:p.right.id,relationship:'time conflict',minutes:p.overlapMinutes,day:p.day}))};}
const relatesToStudy=(s:string)=>/exam|study|revision|school|class|assignment|deadline|learn/i.test(s);
function suggestedAnchor(description:string,items:Commitment[]){const flexible=items.filter(i=>!i.protected);if(!flexible.length)return null;const study=relatesToStudy(description);const preferred=flexible.filter(i=>study?/study|revision|learn|homework/i.test(i.title):/gym|exercise|study|revision|personal/i.test(i.title));const inConflict=new Set(overlapPairs(items).flatMap(p=>[p.left.id,p.right.id]));return [...preferred,...flexible.filter(i=>inConflict.has(i.id)),...flexible][0];}
export function applyOption(items:Commitment[],option:PlanOption){const byId=new Map(option.moves.map(m=>[m.id,m]));return items.map(c=>{const m=byId.get(c.id);return m?{...c,time:m.to}:c;});}
/** A requested reschedule is matched to the saved commitment at its stated original time.
 * Never silently switch to an unrelated commitment because the requested one is protected. */
function explicitReschedule(description:string,items:Commitment[]){
 const match=description.match(/\bfrom\s+([01]\d|2[0-3]):([0-5]\d)\s+to\s+([01]\d|2[0-3]):([0-5]\d)\b/i);
 if(!match)return null;
 const from=`${match[1]}:${match[2]}`,to=`${match[3]}:${match[4]}`;
 const matches=items.filter(c=>c.time===from);
 if(matches.length===1)return {anchor:matches[0]!,from,to,error:''};
 if(matches.length===0)return {anchor:null,from,to,error:`No saved commitment begins at ${from}. Check the existing schedule before proposing a move.`};
 const requestWords=new Set(description.toLowerCase().replace(/practise/g,'practice').match(/[a-z]{4,}/g)??[]);
 const ranked=matches.map(c=>({item:c,score:(c.title.toLowerCase().replace(/practise/g,'practice').match(/[a-z]{4,}/g)??[]).filter(w=>requestWords.has(w)).length})).sort((a,b)=>b.score-a.score);
 if(ranked[0]!.score>0 && ranked[0]!.score>(ranked[1]?.score??-1))return {anchor:ranked[0]!.item,from,to,error:''};
 return {anchor:null,from,to,error:`Several commitments begin at ${from}; identify the exact one before generating a decision.`};
}
export function buildOptions(description:string,commitments:Commitment[]):PlanOption[]{
 for(const c of commitments)validateCommitment(c);
 const before=conflicts(commitments);
 const assumptions=['Only your saved commitments and stated times are checked','No external calendar, finance or wellbeing data is inferred','Free times are searched between 06:00 and 22:00, usually in 15-minute steps'];
 const request=explicitReschedule(description,commitments);
 const invalid=(name:string,note:string,reason:string):PlanOption=>({name,note,moves:[],conflicts:before,tradeoffs:[reason,'No saved commitment is changed.'],valid:false,assumptions,impact:{beforeConflicts:before.length,afterConflicts:before.length,minutesShifted:0,changedCommitments:0,protectedMoved:0,freeTimeMinutes:0}});
 if(request?.error)return [invalid('Clarify the commitment','Which saved item should change?',request.error),invalid('Keep the current plan','No assumptions about which item to change','Your existing schedule remains as saved.'),invalid('Review the Life Map','Open your commitments before proposing a change','Use Plans & updates to check the exact titles and times.')];
 const anchor=request?request.anchor:suggestedAnchor(description,commitments);
 if(!anchor)return [invalid('No safe automatic move','There are no flexible commitments','All existing commitments are protected or no commitments are saved.'),invalid('Request permission','Protected commitments require a separate explicit edit','To change a protected commitment, open Plans & updates and deliberately edit that item; changing it invalidates this proposal.'),invalid('Keep your current plan','Do not modify existing commitments','No safe move can be approved under the current constraints.')];
 if(anchor.protected)return [invalid('Permission required',`${anchor.title} is protected`, `The requested commitment ${anchor.title} cannot be moved automatically. Edit it explicitly in Plans & updates if you wish to change it.`),invalid('Keep protection','Keep your existing schedule unchanged','Your protected commitment is unchanged and cannot be approved for an automatic move.'),invalid('Review other commitments','Manually review availability','Choose a new time or edit the protected commitment yourself; then generate a fresh proposal.')];
 const old=minutes(anchor.time),duration=anchor.durationMinutes??60,day=normalizedDay(anchor.day);
 const occupied=commitments.filter(c=>c.id!==anchor.id&&normalizedDay(c.day)===day);
 const available=(n:number)=>n>=360&&n+duration<=1320&&n!==old&&!overlapPairs([...occupied,{...anchor,time:clock(n)}]).some(p=>p.left.id===anchor.id||p.right.id===anchor.id);
 const desired=request?minutes(request.to):null;
 const availableSlots:number[]=[];
 for(let n=360;n+duration<=1320;n+=15)if(available(n))availableSlots.push(n);
 const used=new Set<number>();
 const option=(name:string,note:string,next:number|null,unavailable:string):PlanOption=>{
  if(next===null||!available(next)||used.has(next))return invalid(name,note,unavailable);
  used.add(next);
  const move:ProposedMove={id:anchor.id,title:anchor.title,from:anchor.time,to:clock(next),day,version:anchor.version??0};
  const afterRows=applyOption(commitments,{moves:[move]} as PlanOption),after=conflicts(afterRows);
  const baseline=new Map(overlapPairs(commitments).map(p=>[[p.left.id,p.right.id].sort().join('|'),p.overlapMinutes]));
  const introduced=overlapPairs(after).some(p=>p.overlapMinutes>(baseline.get([p.left.id,p.right.id].sort().join('|'))??0));
  const valid=!introduced;
  return {name,note,moves:[move],conflicts:after,tradeoffs:[`${anchor.title} moves ${Math.abs(next-old)} minutes ${next<old?'earlier':'later'}`,`${commitments.length-1} other commitments remain unchanged`,`${before.length} existing overlap(s) before; ${after.length} after`,...(after.length?['Existing scheduling conflicts may remain.']:[])],valid,assumptions,impact:{beforeConflicts:before.length,afterConflicts:after.length,minutesShifted:Math.abs(next-old),changedCommitments:1,protectedMoved:0,freeTimeMinutes:0}};
 };
 if(desired!==null){
  const nearest=(side:'earlier'|'later')=>availableSlots.filter(n=>!used.has(n)&&(side==='earlier'?n<desired:n>desired)).sort((a,b)=>Math.abs(a-desired)-Math.abs(b-desired))[0]??null;
  return [option('Requested time',`Move ${anchor.title} to ${request!.to}`,desired,`The requested ${request!.to} slot is unavailable, overlaps another saved commitment, or lies outside scheduling hours. No change is possible at that time.`),option('Earlier available slot','Find a free slot before the requested time',nearest('earlier'),'No available earlier slot without moving other commitments.'),option('Later available slot','Find a free slot after the requested time',nearest('later'),'No available later slot without moving other commitments.')];
 }
 const choose=(kind:'near'|'early'|'late')=>availableSlots.filter(n=>!used.has(n)&&(kind==='early'?n<old:kind==='late'?n>old:true)).sort((a,b)=>kind==='early'?b-a:kind==='late'?a-b:Math.abs(a-old)-Math.abs(b-old)||a-b)[0]??null;
 return [option('Least disruption','Nearest free opening to the original time',choose('near'),'No nearby free slot.'),option('Earlier breathing room','Free earlier slot where available',choose('early'),'No distinct earlier free slot.'),option('Later flexibility','Free later slot where available',choose('late'),'No distinct later free slot.')];
}
export function validateApproval(items:Commitment[],option:PlanOption){if(!option.valid||!option.moves.length)throw new Error('This alternative cannot be approved');const seen=new Set<string>();for(const move of option.moves){if(seen.has(move.id))throw new Error('Duplicate move');seen.add(move.id);const current=items.find(c=>c.id===move.id);if(!current||current.protected||current.time!==move.from||current.version!==move.version||normalizedDay(current.day)!==move.day)throw new Error('A commitment is protected or changed since this proposal');}const after=applyOption(items,option);const baseline=new Map(overlapPairs(items).map(p=>[[p.left.id,p.right.id].sort().join('|'),p.overlapMinutes]));const newConflicts=overlapPairs(after).filter(p=>p.overlapMinutes>(baseline.get([p.left.id,p.right.id].sort().join('|'))??0));if(newConflicts.length)throw new Error('Proposal introduces a scheduling conflict');return after;}
export function canUndo(before:Commitment[],applied:Commitment[],current:Commitment[]):{ok:boolean;reason?:string}{for(const after of applied){const prev=before.find(x=>x.id===after.id);if(!prev)return {ok:false,reason:'Missing original commitment'};const now=current.find(x=>x.id===after.id);if(!now||now.time!==after.time||now.version!==after.version||now.title!==after.title||now.protected!==after.protected||now.durationMinutes!==after.durationMinutes||normalizedDay(now.day)!==normalizedDay(after.day))return {ok:false,reason:`${after.title} changed after approval; undo would overwrite a newer edit.`};}return {ok:true};}
